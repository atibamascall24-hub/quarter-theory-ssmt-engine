//@version=6
indicator("Quarter Theory SSMT Engine v3", overlay=true, max_lines_count=500, max_boxes_count=500)

// ============================================================================
// SIMPLIFIED QUARTER THEORY + SSMT ENGINE - PINE SCRIPT V6 COMPLIANT
// ============================================================================

// Input Parameters
lookback_length = input.int(20, "Lookback Length", minval=5)
fvg_threshold = input.float(0.5, "FVG Threshold %", minval=0.1, maxval=2.0)
sweep_pip_buffer = input.int(10, "Sweep Buffer (pips)", minval=1)

// ============================================================================
// CORE LOGIC - Market Structure Detection
// ============================================================================

// Detect Swing Highs
detect_swing_high(len) =>
    bar_index >= len and high < high[len] and high == ta.highest(high, len)

// Detect Swing Lows  
detect_swing_low(len) =>
    bar_index >= len and low > low[len] and low == ta.lowest(low, len)

// Get last swing high
get_last_swing_high() =>
    result = 0.0
    for i = 0 to 50
        if bar_index >= i and high == ta.highest(high, i + 1)
            if i > 0
                result := high[i]
                break
    result

// Get last swing low
get_last_swing_low() =>
    result = 0.0
    for i = 0 to 50
        if bar_index >= i and low == ta.lowest(low, i + 1)
            if i > 0
                result := low[i]
                break
    result

// ============================================================================
// LIQUIDITY ENGINE - Sweep Detection
// ============================================================================

last_swing_high = ta.highest(high, lookback_length)
last_swing_low = ta.lowest(low, lookback_length)

// Detect bullish sweep (low breaks below previous swing low)
bullish_sweep = low < last_swing_low and low[1] >= last_swing_low

// Detect bearish sweep (high breaks above previous swing high)
bearish_sweep = high > last_swing_high and high[1] <= last_swing_high

// ============================================================================
// SSMT ENGINE - Divergence Detection
// ============================================================================

// Volume-based divergence detection
bullish_divergence = low < low[1] and volume > volume[1]
bearish_divergence = high > high[1] and volume < volume[1]

// RSI for confirmation
rsi_val = ta.rsi(close, 14)
rsi_oversold = rsi_val < 30
rsi_overbought = rsi_val > 70

// ============================================================================
// BIAS ENGINE - Multi-timeframe Context
// ============================================================================

// 5-min trend (current timeframe)
sma_5m = ta.sma(close, 9)
bias_5m_bull = close > sma_5m
bias_5m_bear = close < sma_5m

// Get daily bias via HTF (request higher timeframe data)
daily_close = request.security(syminfo.tickerid, "D", close)
daily_sma = request.security(syminfo.tickerid, "D", ta.sma(close, 20))
bias_daily_bull = daily_close > daily_sma
bias_daily_bear = daily_close < daily_sma

// Get 4-hour bias
h4_close = request.security(syminfo.tickerid, "240", close)
h4_sma = request.security(syminfo.tickerid, "240", ta.sma(close, 20))
bias_h4_bull = h4_close > h4_sma
bias_h4_bear = h4_close < h4_sma

// Alignment check
alignment_bull = bias_daily_bull and bias_h4_bull and bias_5m_bull
alignment_bear = bias_daily_bear and bias_h4_bear and bias_5m_bear

// ============================================================================
// FAIR VALUE GAP (FVG) DETECTION
// ============================================================================

// Bullish FVG: low[2] > high[0]
bullish_fvg = bar_index >= 2 and low[2] > high[0]
bullish_fvg_level = (low[2] + high[0]) / 2

// Bearish FVG: high[2] < low[0]
bearish_fvg = bar_index >= 2 and high[2] < low[0]
bearish_fvg_level = (high[2] + low[0]) / 2

// ============================================================================
// ENTRY SIGNAL GENERATION
// ============================================================================

// LONG Setup: Bullish sweep + Bullish divergence + Alignment + FVG
long_signal = bullish_sweep and bullish_divergence and alignment_bull and bullish_fvg and rsi_oversold

// SHORT Setup: Bearish sweep + Bearish divergence + Alignment + FVG
short_signal = bearish_sweep and bearish_divergence and alignment_bear and bearish_fvg and rsi_overbought

// ============================================================================
// RISK MANAGEMENT
// ============================================================================

// LONG Risk Management
long_entry = long_signal ? close : na
long_stop = long_signal ? last_swing_low - (syminfo.mintick * sweep_pip_buffer) : na
long_risk = long_entry - long_stop
long_target_1 = long_signal ? long_entry + (long_risk * 2) : na
long_target_2 = long_signal ? long_entry + (long_risk * 3) : na

// SHORT Risk Management
short_entry = short_signal ? close : na
short_stop = short_signal ? last_swing_high + (syminfo.mintick * sweep_pip_buffer) : na
short_risk = short_stop - short_entry
short_target_1 = short_signal ? short_entry - (short_risk * 2) : na
short_target_2 = short_signal ? short_entry - (short_risk * 3) : na

// ============================================================================
// VISUALIZATION
// ============================================================================

// Plot swing points
plot(ta.highest(high, lookback_length), "Swing High", color=color.new(color.red, 70), linewidth=2)
plot(ta.lowest(low, lookback_length), "Swing Low", color=color.new(color.green, 70), linewidth=2)

// Plot FVG levels
plot(bullish_fvg ? bullish_fvg_level : na, "Bullish FVG", color=color.new(color.lime, 50), linewidth=1, style=plot.style_line)
plot(bearish_fvg ? bearish_fvg_level : na, "Bearish FVG", color=color.new(color.red, 50), linewidth=1, style=plot.style_line)

// Plot entry signals
plotshape(long_signal, "LONG Signal", shape.labelup, location.belowbar, color=color.new(color.green, 0), size=size.large)
plotshape(short_signal, "SHORT Signal", shape.labeldown, location.abovebar, color=color.new(color.red, 0), size=size.large)

// Plot entry, stop, target levels
plot(long_entry, "Long Entry", color=color.blue, linewidth=2, style=plot.style_circles)
plot(long_stop, "Long Stop", color=color.new(color.red, 0), linewidth=1, style=plot.style_dashed)
plot(long_target_1, "Long Target 1", color=color.new(color.green, 0), linewidth=1, style=plot.style_dashed)
plot(long_target_2, "Long Target 2", color=color.new(color.green, 0), linewidth=1, style=plot.style_dashed)

plot(short_entry, "Short Entry", color=color.blue, linewidth=2, style=plot.style_circles)
plot(short_stop, "Short Stop", color=color.new(color.red, 0), linewidth=1, style=plot.style_dashed)
plot(short_target_1, "Short Target 1", color=color.new(color.green, 0), linewidth=1, style=plot.style_dashed)
plot(short_target_2, "Short Target 2", color=color.new(color.green, 0), linewidth=1, style=plot.style_dashed)

// Plot bias colors
bgcolor(alignment_bull ? color.new(color.green, 85) : alignment_bear ? color.new(color.red, 85) : color.new(color.gray, 95))

// ============================================================================
// DIAGNOSTICS TABLE
// ============================================================================

var table info_table = na

if barstate.islast
    if na(info_table)
        info_table := table.new(position=position.top_right, columns=2, rows=10, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)
        
    // Bias info
    daily_bias_text = bias_daily_bull ? "BULL" : bias_daily_bear ? "BEAR" : "NEUTRAL"
    h4_bias_text = bias_h4_bull ? "BULL" : bias_h4_bear ? "BEAR" : "NEUTRAL"
    m5_bias_text = bias_5m_bull ? "BULL" : bias_5m_bear ? "BEAR" : "NEUTRAL"
    alignment_text = alignment_bull ? "BULL ALIGNED" : alignment_bear ? "BEAR ALIGNED" : "CONFLICT"
    
    table.cell(info_table, 0, 0, "DAILY", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 0, daily_bias_text, text_color=bias_daily_bull ? color.green : bias_daily_bear ? color.red : color.white)
    
    table.cell(info_table, 0, 1, "4H", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 1, h4_bias_text, text_color=bias_h4_bull ? color.green : bias_h4_bear ? color.red : color.white)
    
    table.cell(info_table, 0, 2, "5M", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 2, m5_bias_text, text_color=bias_5m_bull ? color.green : bias_5m_bear ? color.red : color.white)
    
    table.cell(info_table, 0, 3, "ALIGNMENT", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 3, alignment_text, text_color=alignment_bull ? color.green : alignment_bear ? color.red : color.orange)
    
    table.cell(info_table, 0, 4, "RSI", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 4, str.tostring(math.round(rsi_val, 2)), text_color=rsi_oversold ? color.lime : rsi_overbought ? color.red : color.white)
    
    table.cell(info_table, 0, 5, "SWEEP BULL", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 5, bullish_sweep ? "YES" : "NO", text_color=bullish_sweep ? color.lime : color.white)
    
    table.cell(info_table, 0, 6, "SWEEP BEAR", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 6, bearish_sweep ? "YES" : "NO", text_color=bearish_sweep ? color.red : color.white)
    
    table.cell(info_table, 0, 7, "FVG BULL", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 7, bullish_fvg ? "YES" : "NO", text_color=bullish_fvg ? color.lime : color.white)
    
    table.cell(info_table, 0, 8, "FVG BEAR", text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(info_table, 1, 8, bearish_fvg ? "YES" : "NO", text_color=bearish_fvg ? color.red : color.white)
    
    table.cell(info_table, 0, 9, "STATUS", text_color=color.white, bgcolor=color.new(color.black, 80))
    status_text = long_signal ? "LONG SIGNAL" : short_signal ? "SHORT SIGNAL" : "AWAITING SETUP"
    table.cell(info_table, 1, 9, status_text, text_color=long_signal ? color.green : short_signal ? color.red : color.white)
