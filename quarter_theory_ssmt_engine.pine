//@version=6
indicator("Quarter Theory + SSMT Institutional Engine v2.0", overlay=true, max_lines_count=500, max_boxes_count=500)

// ============================================================================
// CORE FRAMEWORK - Phase 4.1 - FIXED FOR PINE SCRIPT V6
// ============================================================================

// Custom Types
type CycleSnapshot
    int cycle_id
    string cycle_type
    float open_price
    float high_price
    float low_price
    float close_price
    string bias
    int timestamp_val
    bool confirmed

type LiquidityEvent
    float price_val
    string sweep_type
    int timestamp_val
    bool swept
    float reaction_price

type StructurePoint
    float price_val
    string point_type
    int timestamp_val
    bool confirmed

type SSMTSignal
    bool detected
    string divergence_type
    float price_val
    int timestamp_val
    bool confirmed

type TradeSignal
    string trade_id
    string symbol
    string direction
    float entry_price
    float stop_loss
    array<float> targets
    string grade
    int weekly_id
    int daily_id
    int cycle_90m_id
    int micro_id
    string liq_ref
    string ssmt_ref
    string structure_ref
    int timestamp_val
    string status

// Global Buffers
var array<CycleSnapshot> weekly_history = array.new<CycleSnapshot>()
var array<CycleSnapshot> daily_history = array.new<CycleSnapshot>()
var array<CycleSnapshot> cycle_90m_history = array.new<CycleSnapshot>()
var array<CycleSnapshot> micro_history = array.new<CycleSnapshot>()

var array<LiquidityEvent> liquidity_buffer = array.new<LiquidityEvent>()
var array<StructurePoint> structure_buffer = array.new<StructurePoint>()
var array<SSMTSignal> ssmt_buffer = array.new<SSMTSignal>()
var array<TradeSignal> trade_signals = array.new<TradeSignal>()

// State
var string weekly_bias = "NEUTRAL"
var string daily_bias = "NEUTRAL"
var string bias_90m = "NEUTRAL"

// ============================================================================
// PHASE 4.2 - QUARTER THEORY CYCLE ENGINE
// ============================================================================

f_get_ny_hour() =>
    // Simplified: get current hour (EST = UTC-5)
    curr_hour = hour(time)
    curr_hour

f_get_ny_dayofweek() =>
    curr_day = dayofweek(time)
    curr_day

f_get_year_week() =>
    cy = year(time)
    cw = weekofyear(time)
    cy * 100 + cw

f_get_year_day() =>
    cy = year(time)
    cd = dayofweek(time) + (month(time) * 30)
    cy * 10000 + cd

f_get_90m_id() =>
    curr_hour = f_get_ny_hour()
    curr_min = minute(time)
    total_min = curr_hour * 60 + curr_min
    block_num = math.floor(total_min / 90)
    block_num

f_get_micro_id() =>
    curr_hour = f_get_ny_hour()
    curr_min = minute(time)
    total_min = curr_hour * 60 + curr_min
    block_num = math.floor(total_min / 5)
    block_num

f_detect_bias(open_p, close_p) =>
    if close_p > open_p
        "BULL"
    else if close_p < open_p
        "BEAR"
    else
        "NEUTRAL"

f_update_weekly() =>
    week_id = f_get_year_week()
    
    if array.size(weekly_history) == 0 or weekly_history.last().cycle_id != week_id
        snap = CycleSnapshot.new()
        snap.cycle_id := week_id
        snap.cycle_type := "WEEKLY"
        snap.open_price := open[1]
        snap.high_price := high[1]
        snap.low_price := low[1]
        snap.close_price := close[1]
        snap.bias := f_detect_bias(open[1], close[1])
        snap.timestamp_val := time[1]
        snap.confirmed := true
        
        array.push(weekly_history, snap)
        
        if array.size(weekly_history) > 52
            array.shift(weekly_history)
        
        weekly_bias := snap.bias

f_update_daily() =>
    day_id = f_get_year_day()
    
    if array.size(daily_history) == 0 or daily_history.last().cycle_id != day_id
        snap = CycleSnapshot.new()
        snap.cycle_id := day_id
        snap.cycle_type := "DAILY"
        snap.open_price := open[1]
        snap.high_price := high[1]
        snap.low_price := low[1]
        snap.close_price := close[1]
        snap.bias := f_detect_bias(open[1], close[1])
        snap.timestamp_val := time[1]
        snap.confirmed := true
        
        array.push(daily_history, snap)
        
        if array.size(daily_history) > 365
            array.shift(daily_history)
        
        daily_bias := snap.bias

f_update_90m() =>
    id_90m = f_get_90m_id()
    
    if array.size(cycle_90m_history) == 0 or cycle_90m_history.last().cycle_id != id_90m
        snap = CycleSnapshot.new()
        snap.cycle_id := id_90m
        snap.cycle_type := "90M"
        snap.open_price := open
        snap.high_price := high
        snap.low_price := low
        snap.close_price := close
        snap.bias := f_detect_bias(open, close)
        snap.timestamp_val := time
        snap.confirmed := barstate.isconfirmed
        
        array.push(cycle_90m_history, snap)
        
        if array.size(cycle_90m_history) > 200
            array.shift(cycle_90m_history)
        
        bias_90m := snap.bias

f_update_micro() =>
    id_micro = f_get_micro_id()
    
    if array.size(micro_history) == 0 or micro_history.last().cycle_id != id_micro
        snap = CycleSnapshot.new()
        snap.cycle_id := id_micro
        snap.cycle_type := "MICRO"
        snap.open_price := open
        snap.high_price := high
        snap.low_price := low
        snap.close_price := close
        snap.bias := f_detect_bias(open, close)
        snap.timestamp_val := time
        snap.confirmed := barstate.isconfirmed
        
        array.push(micro_history, snap)
        
        if array.size(micro_history) > 500
            array.shift(micro_history)

// ============================================================================
// PHASE 4.3 - MARKET STRUCTURE ENGINE
// ============================================================================

f_detect_swing_high(length) =>
    if bar_index < length
        false
    else
        is_high = high < high[length]
        for i = 1 to length - 1
            if high < high[i]
                is_high := false
                break
        is_high

f_detect_swing_low(length) =>
    if bar_index < length
        false
    else
        is_low = low > low[length]
        for i = 1 to length - 1
            if low > low[i]
                is_low := false
                break
        is_low

f_update_structure() =>
    swing_len = 3
    
    if f_detect_swing_high(swing_len)
        sp = StructurePoint.new()
        sp.price_val := high
        sp.point_type := "SWING_HIGH"
        sp.timestamp_val := time
        sp.confirmed := barstate.isconfirmed
        array.push(structure_buffer, sp)
    
    if f_detect_swing_low(swing_len)
        sp = StructurePoint.new()
        sp.price_val := low
        sp.point_type := "SWING_LOW"
        sp.timestamp_val := time
        sp.confirmed := barstate.isconfirmed
        array.push(structure_buffer, sp)
    
    if array.size(structure_buffer) > 200
        array.shift(structure_buffer)

f_get_last_high() =>
    result = 0.0
    for i = array.size(structure_buffer) - 1 to 0 by -1
        if structure_buffer.get(i).point_type == "SWING_HIGH"
            result := structure_buffer.get(i).price_val
            break
    result

f_get_last_low() =>
    result = 0.0
    for i = array.size(structure_buffer) - 1 to 0 by -1
        if structure_buffer.get(i).point_type == "SWING_LOW"
            result := structure_buffer.get(i).price_val
            break
    result

// ============================================================================
// PHASE 4.4 - LIQUIDITY ENGINE
// ============================================================================

f_detect_liquidity() =>
    if array.size(structure_buffer) >= 2
        last_high = f_get_last_high()
        last_low = f_get_last_low()
        
        if last_low > 0 and low < last_low
            liq = LiquidityEvent.new()
            liq.price_val := last_low
            liq.sweep_type := "SWEEP"
            liq.timestamp_val := time
            liq.swept := true
            liq.reaction_price := close
            array.push(liquidity_buffer, liq)
        
        if last_high > 0 and high > last_high
            liq = LiquidityEvent.new()
            liq.price_val := last_high
            liq.sweep_type := "SWEEP"
            liq.timestamp_val := time
            liq.swept := true
            liq.reaction_price := close
            array.push(liquidity_buffer, liq)
    
    if array.size(liquidity_buffer) > 300
        array.shift(liquidity_buffer)

f_get_last_sweep() =>
    result = na(LiquidityEvent)
    for i = array.size(liquidity_buffer) - 1 to 0 by -1
        if liquidity_buffer.get(i).sweep_type == "SWEEP"
            result := liquidity_buffer.get(i)
            break
    result

// ============================================================================
// PHASE 4.5 - SSMT ENGINE
// ============================================================================

f_detect_ssmt() =>
    if bar_index > 20
        if low < low[1] and volume > volume[1]
            sig = SSMTSignal.new()
            sig.detected := true
            sig.divergence_type := "BULLISH"
            sig.price_val := low
            sig.timestamp_val := time
            sig.confirmed := barstate.isconfirmed
            array.push(ssmt_buffer, sig)
        
        if high > high[1] and volume < volume[1]
            sig = SSMTSignal.new()
            sig.detected := true
            sig.divergence_type := "BEARISH"
            sig.price_val := high
            sig.timestamp_val := time
            sig.confirmed := barstate.isconfirmed
            array.push(ssmt_buffer, sig)
    
    if array.size(ssmt_buffer) > 150
        array.shift(ssmt_buffer)

f_get_last_ssmt() =>
    result = na(SSMTSignal)
    for i = array.size(ssmt_buffer) - 1 to 0 by -1
        if ssmt_buffer.get(i).confirmed
            result := ssmt_buffer.get(i)
            break
    result

// ============================================================================
// PHASE 4.6 - BIAS ENGINE
// ============================================================================

f_get_alignment() =>
    if daily_bias == bias_90m
        daily_bias + "_ALIGNED"
    else
        "CONFLICT"

// ============================================================================
// PHASE 4.7 - ENTRY ENGINE
// ============================================================================

f_calculate_fvg() =>
    fvg_t = "NONE"
    fvg_l = 0.0
    
    if bar_index >= 2
        if low[2] > high[0]
            fvg_t := "BULLISH"
            fvg_l := (low[2] + high[0]) / 2
        else if high[2] < low[0]
            fvg_t := "BEARISH"
            fvg_l := (high[2] + low[0]) / 2
    
    [fvg_t, fvg_l]

f_generate_trades() =>
    if array.size(cycle_90m_history) == 0 or array.size(structure_buffer) < 2 or array.size(liquidity_buffer) == 0
        return
    
    alignment = f_get_alignment()
    
    if alignment == "CONFLICT"
        return
    
    sweep = f_get_last_sweep()
    
    if na(sweep)
        return
    
    ssmt_sig = f_get_last_ssmt()
    
    if not na(ssmt_sig) and ssmt_sig.confirmed
        [fvg_type, fvg_level] = f_calculate_fvg()
        
        if daily_bias == "BULL" and bias_90m == "BULL"
            if ssmt_sig.divergence_type == "BULLISH" and fvg_type == "BULLISH"
                entry_p = fvg_level
                stop_p = sweep.price_val - (syminfo.mintick * 10)
                target1_p = sweep.price_val + (entry_p - stop_p) * 2
                target2_p = sweep.price_val + (entry_p - stop_p) * 3
                
                trade = TradeSignal.new()
                trade.trade_id := str.tostring(time)
                trade.symbol := syminfo.tickerid
                trade.direction := "LONG"
                trade.entry_price := entry_p
                trade.stop_loss := stop_p
                trade.targets := array.from(target1_p, target2_p)
                trade.grade := "A"
                trade.weekly_id := f_get_year_week()
                trade.daily_id := f_get_year_day()
                trade.cycle_90m_id := f_get_90m_id()
                trade.micro_id := f_get_micro_id()
                trade.liq_ref := str.tostring(sweep.price_val)
                trade.ssmt_ref := ssmt_sig.divergence_type
                trade.structure_ref := str.tostring(fvg_level)
                trade.timestamp_val := time
                trade.status := "PENDING"
                
                array.push(trade_signals, trade)
        
        if daily_bias == "BEAR" and bias_90m == "BEAR"
            if ssmt_sig.divergence_type == "BEARISH" and fvg_type == "BEARISH"
                entry_p = fvg_level
                stop_p = sweep.price_val + (syminfo.mintick * 10)
                target1_p = sweep.price_val - (stop_p - entry_p) * 2
                target2_p = sweep.price_val - (stop_p - entry_p) * 3
                
                trade = TradeSignal.new()
                trade.trade_id := str.tostring(time)
                trade.symbol := syminfo.tickerid
                trade.direction := "SHORT"
                trade.entry_price := entry_p
                trade.stop_loss := stop_p
                trade.targets := array.from(target1_p, target2_p)
                trade.grade := "A"
                trade.weekly_id := f_get_year_week()
                trade.daily_id := f_get_year_day()
                trade.cycle_90m_id := f_get_90m_id()
                trade.micro_id := f_get_micro_id()
                trade.liq_ref := str.tostring(sweep.price_val)
                trade.ssmt_ref := ssmt_sig.divergence_type
                trade.structure_ref := str.tostring(fvg_level)
                trade.timestamp_val := time
                trade.status := "PENDING"
                
                array.push(trade_signals, trade)
    
    if array.size(trade_signals) > 50
        array.shift(trade_signals)

// ============================================================================
// MAIN EXECUTION
// ============================================================================

f_update_weekly()
f_update_daily()
f_update_90m()
f_update_micro()
f_update_structure()
f_detect_liquidity()
f_detect_ssmt()
f_generate_trades()

// ============================================================================
// VISUALIZATION
// ============================================================================

plot_y = close + (high - low) * 2
color_w = weekly_bias == "BULL" ? color.new(color.green, 80) : weekly_bias == "BEAR" ? color.new(color.red, 80) : color.new(color.gray, 80)
plot(plot_y, title="Weekly Bias", color=color_w, linewidth=3, display=display.none)

sweep = f_get_last_sweep()
if not na(sweep)
    line.new(bar_index - 50, sweep.price_val, bar_index, sweep.price_val, color=color.orange, width=2, style=line.style_dashed)

sig = f_get_last_ssmt()
if not na(sig) and sig.confirmed
    marker_col = sig.divergence_type == "BULLISH" ? color.lime : color.fuchsia
    plot(sig.price_val, title="SSMT Signal", color=marker_col, style=plot.style_circles, linewidth=3)

if array.size(trade_signals) > 0
    latest = trade_signals.last()
    if latest.status == "PENDING"
        line.new(bar_index - 20, latest.entry_price, bar_index, latest.entry_price, color=color.blue, width=2)
        line.new(bar_index - 20, latest.stop_loss, bar_index, latest.stop_loss, color=color.red, width=2, style=line.style_dotted)
        line.new(bar_index - 20, latest.targets.get(0), bar_index, latest.targets.get(0), color=color.green, width=2, style=line.style_dashed)

// ============================================================================
// DIAGNOSTICS TABLE
// ============================================================================

var table diag = na

if barstate.islast
    if na(diag)
        diag := table.new(position=position.top_right, columns=2, rows=8, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)
        
        table.cell(diag, 0, 0, "WEEKLY BIAS", text_color=color.white)
        table.cell(diag, 1, 0, weekly_bias, text_color=color.white)
        
        table.cell(diag, 0, 1, "DAILY BIAS", text_color=color.white)
        table.cell(diag, 1, 1, daily_bias, text_color=color.white)
        
        table.cell(diag, 0, 2, "90M BIAS", text_color=color.white)
        table.cell(diag, 1, 2, bias_90m, text_color=color.white)
        
        table.cell(diag, 0, 3, "ALIGNMENT", text_color=color.white)
        table.cell(diag, 1, 3, f_get_alignment(), text_color=color.white)
        
        table.cell(diag, 0, 4, "SWEEPS", text_color=color.white)
        table.cell(diag, 1, 4, str.tostring(array.size(liquidity_buffer)), text_color=color.white)
        
        table.cell(diag, 0, 5, "SSMT SIGNALS", text_color=color.white)
        table.cell(diag, 1, 5, str.tostring(array.size(ssmt_buffer)), text_color=color.white)
        
        table.cell(diag, 0, 6, "TRADES", text_color=color.white)
        table.cell(diag, 1, 6, str.tostring(array.size(trade_signals)), text_color=color.white)
        
        table.cell(diag, 0, 7, "STATUS", text_color=color.white)
        if array.size(trade_signals) > 0
            latest = trade_signals.last()
            table.cell(diag, 1, 7, latest.status + " | " + latest.direction, text_color=color.white)
        else
            table.cell(diag, 1, 7, "AWAITING SETUP", text_color=color.white)
